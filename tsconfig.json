{
	"compilerOptions": {
        "target": "ES2020",
        "module": "CommonJS",
        "lib": ["ES2020"],
        "moduleResolution": "Node",
        "outDir": "./build",
        "rootDir": "./src",
        "strict": true,
        "allowJs": true,
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "typeRoots": ["./node_modules/@types", "./src/types"]

      },
      "include": ["src/**/*"],
      "exclude": ["node_modules"],
      "ts-node": {
        "files": true
      }
}
